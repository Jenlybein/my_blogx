[client]
port        = 3306
socket      = /var/run/mysqld/mysqld.sock

[mysqld_safe]
pid-file    = /var/run/mysqld/mysqld.pid
socket      = /var/run/mysqld/mysqld.sock
nice        = 0  # 进程优先级（0为默认，数值越小优先级越高）

[mysqld]
user        = mysql
pid-file    = /var/run/mysqld/mysqld.pid
socket      = /var/run/mysqld/mysqld.sock
port        = 3306
basedir     = /usr
datadir     = /var/lib/mysql
tmpdir      = /tmp
secure-file-priv=/var/lib/mysql-files
lc-messages-dir = /usr/share/mysql
explicit_defaults_for_timestamp

log-bin = mysql-bin
server-id = 1
binlog_format = ROW                         # binlog格式为ROW（行级日志），解析准确、适配go-mysql同步
sync_binlog = 1                             # 每次binlog写入立即刷盘，防止宕机丢失binlog
expire_logs_days = 7                        # binlog保留7天，避免被提前清理（适配同步消费速度）
max_binlog_size = 1G                        # 单个binlog文件最大1G，避免频繁切换
innodb_flush_log_at_trx_commit=1            # 事务提交立即刷盘，保证数据不丢失（ACID合规）

bind-address=0.0.0.0  # 允许所有IP连接（生产环境建议改为具体IP，如REDACTED_SERVER_IP）
