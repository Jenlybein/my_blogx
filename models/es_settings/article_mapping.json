{
  "settings": {
    "index.default_pipeline": "article_pipeline",
    "analysis": {
      "char_filter": {
        "my_html_strip": {
          "type": "html_strip",
          "escaped_tags": []
        }
      },
      "analyzer": {
        "ik_html_analyzer": {
          "type": "custom",
          "char_filter": ["my_html_strip"],
          "tokenizer": "ik_max_word",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "integer"
      },
      "created_at": {
        "type": "date",
        "null_value": "null"
      },
      "updated_at": {
        "type": "date",
        "null_value": "null"
      },
      "title": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "abstract": {
        "type": "text"
      },
      "html_content": {
        "type": "text",
        "analyzer": "ik_html_analyzer",
        "search_analyzer": "ik_smart"
      },
      "category_id": {
        "type": "integer"
      },
      "tag_list": {
        "type": "keyword"
      },
      "cover": {
        "type": "keyword"
      },
      "author_id": {
        "type": "integer"
      },
      "view_count": {
        "type": "integer"
      },
      "digg_count": {
        "type": "integer"
      },
      "comment_count": {
        "type": "integer"
      },
      "favor_count": {
        "type": "integer"
      },
      "status": {
        "type": "integer"
      },
      "comments_toggle": {
        "type": "integer"
      }
    }
  }
}
